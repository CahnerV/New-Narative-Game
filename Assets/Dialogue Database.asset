      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 1
        originDialogueID: 5
        destinationConversationID: 1
        destinationDialogueID: 13
        isConnector: 0
        priority: 2
      conditionsString: 
