          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 594.81134
        y: 69.77359
        width: 160
        height: 30
    - id: 7
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Willie looks at you with with a grin, "Sure you''re smart, bud, but
          this thing isn''t really for camping. You''re glamping this point!" You
          stare at him with confusion. He stares back. "Glamping? You know, like
          camping with all this extra stuff? That glamping?"

          

          You''re
          still confused, but Willie ignores your confusion and hops on anyways.
          "Whatever man, just kick it into high gear so we can get Justin. Heard
          he''s been ready since 6 AM."'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 1
        originDialogueID: 7
        destinationConversationID: 1
        destinationDialogueID: 11
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 686
        y: 199
        width: 160
        height: 30
    - id: 8
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Willie looks at you with a smug grin. "I''ll have you know that I
          brought the only thing I''ll need for this whole trip," he says, bowing
          towards the small sleeping bag hanging off of his shoulder.

          "This
          baby''s got everything I''ll need to stave the cold nights away!"

          

          Willie
          struts into the Rv and sits comfortably on the couch. "Justin''s been bugging
          me all morning about this trip, so we better hustle to get him before he
          starts exploding his "camping facts" onto his parents!"'
        type: 0
        typeString: 
