      - originConversationID: 1
        originDialogueID: 4
        destinationConversationID: 1
        destinationDialogueID: 6
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 366
        y: 57
        width: 160
        height: 30
    - id: 5
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: -1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: "You, in your wealthy wisdoms, decide that an RV is the best thing
          to bring on this trip. As you pick up your friends, you see the supplies
          they decided to bring with themselves. \n\nAs you pick Willie up, he greets
          you with a toothy grin. He's wearing the same thing he always wears: Levi
          jeans, a dirty white tanktop, and his Tims, which he paid extra to modify
          with wheelies. His watch and chain necklaces beam the sun into your eyes."
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 1
        originDialogueID: 5
        destinationConversationID: 1
        destinationDialogueID: 1
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 134.9434
        y: 97
        width: 160
        height: 30
    - id: 6
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\"Ok, ok, don't get your skinny jeans in a twist,\" Says Willie,
          holding his hands up in defense, \"but just so you know, I am NOT spending
          a single night in that thing as long as I don't have to. I got my sleeping
          bag, and that is the only thing I'm gonna need!\" \r\n\r\nAfter that \"heartwarming\"
          statement, Willie climbs on and takes a seat at the mini table. \"Now,
          get moving towards Justin's place, poor guy's probably thinking we left
          without him at this point.\""
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 1
        originDialogueID: 6
