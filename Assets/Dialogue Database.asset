      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: '"Well, what did the so-called "Smart Guy" bring?"'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
